# Docker Hub Configuration
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# App Port

# PostgreSQL Configuration
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=focusflow

# Directory on host for PostgreSQL data (for easy backup)
# Use absolute path for production
POSTGRES_DATA_DIR=./data/postgres

# NextAuth Configuration
# The public hostname Caddy serves and obtains a certificate for. NEXTAUTH_URL is
# derived from it (https://DOMAIN) — there is no http mode in the prod compose.
DOMAIN=focusflow.example.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# Groq API Key
GROQ_API_KEY=your-groq-api-key-here

# A public instance should not accept strangers. Leave false; flip to true only
# for the minutes it takes to create an account, then back — see docs/DEPLOY.md.
ALLOW_SIGNUP=false

# Background web push (optional). `npm run push:keys` prints the pair; keep it.
# Enable the dispatcher with:  docker compose --profile push up -d
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=
